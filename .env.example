# Copy this file to .env.local and fill in the values from
#   Supabase dashboard -> Connect (or Project Settings -> API Keys)
# .env.local is git-ignored. NEVER commit it.
# On Vercel, add the same two names under Project -> Settings -> Environment
# Variables, then redeploy.
#
# Only these two variables are needed. Do NOT add a secret / service_role key:
# it bypasses all row-level security and must never reach client code.
# Older projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the
# publishable key; the app accepts either name.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
